# Copie para .env (ignorado pelo Git) e ajuste. NUNCA versione o .env.
# O docker compose lê o .env automaticamente; sem ele, usa os valores padrão de desenvolvimento local.

# Banco de dados (PostgreSQL). Valores padrão servem apenas para o ambiente local.
DB_NAME=geoprag
DB_USER=geoprag
DB_PASSWORD=troque-esta-senha

# Autenticação (JWT). Usados pelas features de login; defina um valor longo e aleatório fora do ambiente local.
JWT_SECRET=
JWT_ACCESS_TOKEN_MINUTES=15

# CORS: origens permitidas, separadas por vírgula (ex.: origem do portal Web local).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Perfil do Spring. O Compose usa `local` por padrão, que carrega o SEED FICTÍCIO (usuários de teste; ver README).
# Em qualquer ambiente compartilhado, NÃO use `local`: sem esse perfil o seed nunca é carregado.
SPRING_PROFILES_ACTIVE=local
